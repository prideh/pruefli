// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Teacher {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  classes      Class[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Class {
  id        String    @id @default(uuid())
  name      String    // e.g. "Klasse 9b"
  teacherId String
  teacher   Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  students  Student[]
  exams     Exam[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Student {
  id          String       @id @default(uuid())
  name        String       // e.g. "Max Mustermann"
  classId     String
  class       Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  submissions Submission[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Exam {
  id               String       @id @default(uuid())
  title            String       // e.g. "Mathematik Klassenarbeit 1"
  subject          String       // e.g. "Mathematik"
  rubricText       String       // Tier 2: Musterlösung / Erwartungshorizont
  examTemplateText String?      // Tier 1: Vorlagenprüfung (Aufgabenblatt / offizielle Punktelimits)
  gradingNotes     String?      // Tier 3: Unterrichtsmaterial / zusätzliche Bewertungshinweise
  gradingFormula   String       @default("LINEAR_60") // "LINEAR_60", "KNICK_50", "KNICK_66"
  gradeRounding    String       @default("0.1")       // "0.1", "0.25", "0.5"
  maxPoints        Float
  classId          String
  class            Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  submissions      Submission[]
  tasks            ExamTask[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

enum SubmissionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Submission {
  id                      String           @id @default(uuid())
  examId                  String
  exam                    Exam             @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId               String?
  student                 Student?         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  targetStudentId         String?
  extractedStudentName    String?
  suggestedStudentId      String?
  isStudentMatchUncertain Boolean          @default(false)
  isExamMatchUncertain    Boolean          @default(false)
  status                  SubmissionStatus @default(PENDING)

  // Grading metrics
  earnedPoints           Float            @default(0.0)
  gradeRaw               Float            @default(1.0)
  gradeRounded           String           @default("1.0") // Schweizer Note gerundet (z. B. "5.0")

  // AI summary feedback
  strengths              String[]
  weaknesses             String[]
  helpfulTip             String?
  exerciseRecommendation String?

  // Failure reason capturing
  errorMessage           String?

  // Scan metadata
  // NOTE FOR PRODUCTION DEPLOYMENTS:
  // currently we are using Option A (local filesystem upload under public/uploads/).
  // TODO: Migrate this schema and local filesystem helper functions to an S3-compatible cloud storage solution
  // (e.g., AWS S3, Supabase Storage, or Vercel Blob) when deploying to high-volume multi-client production environments.
  studentExamUrl         String?

  tasks                  TaskCorrection[]
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  @@unique([examId, studentId]) // Prevent duplicate submissions for the same exam per student
}

enum TaskStatus {
  Korrekt
  Folgefehler
  Fehler
}

model TaskCorrection {
  id              String           @id @default(uuid())
  submissionId    String
  submission      Submission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  taskId          String           // e.g. "1" (from Gemini response)
  title           String           // e.g. "Aufgabe 1"
  studentAnswer   String           // Handwriting transcribed by AI
  erzieltePunkte  Float            @default(0.0)
  maximalPunkte   Float
  status          TaskStatus
  lehrerKommentar String           @default("")
  orderIndex      Int              @default(0)

  schritte        StepCorrection[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

enum ErrorType {
  KeinFehler
  Rechenfehler
  Folgefehler
  SonstigerFehler
}

model StepCorrection {
  id                 String         @id @default(uuid())
  taskCorrectionId   String
  taskCorrection     TaskCorrection @relation(fields: [taskCorrectionId], references: [id], onDelete: Cascade)
  schrittIndex       Int
  schrittText        String         // e.g. "4x = 16"
  istKorrekt         Boolean
  fehlerTyp          ErrorType
  erreichtePunkte    Float          @default(0.0)
  maximalPunkte      Float
  begruendung        String
  istUnsicher        Boolean        @default(false)
  unsicherheitsGrund String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

model ExamTask {
  id         String   @id @default(uuid())
  examId     String
  exam       Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  taskId     String   // e.g. "1"
  title      String   // e.g. "Aufgabe 1"
  maxPoints  Float
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([examId, taskId])
}

model CorrectionLog {
  id            String   @id @default(uuid())
  createdAt     DateTime @default(now())
  submissionId  String?  // Links to active submission (nullified or kept upon deletion)
  teacherId     String   // Owner of this log (retained even if parent records are deleted)

  // Decoupled context fields (preserved even if parent records are deleted)
  className     String
  examTitle     String
  studentName   String   @default("Automatische Zuordnung")

  // Execution statistics
  modelUsed     String   @default("gemini-3.8-flash")
  durationMs    Int?     // Processing time in milliseconds
  status        String   // "PENDING", "PROCESSING", "COMPLETED", "FAILED", "CANCELLED"
  actionType    String   // "ERSTELLT" (new correction), "ERSETZT" (replaced conflict), "NEUSTART" (re-run from failure)

  // Auditing payloads
  errorMessage  String?
}

model TeacherSession {
  id                String    @id
  teacherId         String    @map("teacher_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  expiresAt         DateTime  @map("expires_at")
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at")
  lastRenewedAt     DateTime  @default(now()) @map("last_renewed_at")
  revokedAt         DateTime? @map("revoked_at")
  userAgent         String?   @map("user_agent")
  tokenVersion      Int       @default(1) @map("token_version")
  isLegacyConverted Boolean   @default(false) @map("is_legacy_converted")

  @@index([teacherId])
  @@map("teacher_sessions")
}

model TeacherSessionRevocation {
  teacherId     String   @id @map("teacher_id")
  revokedBefore DateTime @map("revoked_before")

  @@map("teacher_session_revocations")
}

model TeacherEmailVerification {
  teacherId  String   @id @map("teacher_id")
  email      String
  verifiedAt DateTime @default(now()) @map("verified_at")

  @@map("teacher_email_verifications")
}

model TeacherFederatedIdentity {
  id                String   @id
  teacherId         String   @map("teacher_id")
  provider          String
  providerAccountId String   @map("provider_account_id")
  email             String
  createdAt         DateTime @default(now()) @map("created_at")

  @@unique([provider, providerAccountId])
  @@index([teacherId])
  @@map("teacher_federated_identities")
}

model ClassArchive {
  classId    String   @id @map("class_id")
  archivedAt DateTime @default(now()) @map("archived_at")

  @@map("class_archives")
}

model TeacherSubjectPreference {
  teacherId    String   @id @map("teacher_id")
  subjectsJson String   @map("subjects_json")
  updatedAt    DateTime @default(now()) @map("updated_at")

  @@map("teacher_subject_preferences")
}

model ClassSubjectPreference {
  classId      String   @id @map("class_id")
  subjectsJson String   @map("subjects_json")
  updatedAt    DateTime @default(now()) @map("updated_at")

  @@map("class_subject_preferences")
}

model RelayDocument {
  sessionId  String @id @map("session_id")
  id         String
  teacherId  String @map("teacher_id")
  targetMode String @map("target_mode")
  payload    String
  pageCount  Int    @default(1) @map("page_count")
  createdAt  BigInt @map("created_at")

  @@index([teacherId])
  @@map("relay_documents")
}

